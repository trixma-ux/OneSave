# Exemple de variables d'environnement pour OneSave

# Backend (server/.env)
DATABASE_URL="file:./server/prisma/dev.db"
JWT_SECRET="changez_ce_secret_en_production"
PORT=5000
NODE_ENV=development

# Admin par défaut (modifiable) - utilisé par le serveur
DEFAULT_ADMIN_EMAIL=admin@cnf.ci
DEFAULT_ADMIN_PASSWORD=admin123

# Frontend (client/.env)
REACT_APP_API_URL=http://localhost:5000/api
REACT_APP_DEFAULT_ADMIN_EMAIL=admin@cnf.ci
REACT_APP_DEFAULT_ADMIN_PASSWORD=admin123
