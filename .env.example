# Exemple de variables d'environnement pour OneSave

# Backend (server/.env)
DATABASE_URL="file:./server/prisma/dev.db"
JWT_SECRET="changez_ce_secret_en_production"  # obligatoire en production
PORT=5000
NODE_ENV=development

# Admin initial - utilisé UNIQUEMENT par le serveur.
# En production : obligatoire, mot de passe fort (admin123 refusé).
# JWT_SECRET est aussi obligatoire en production (le serveur refuse de démarrer sinon).
DEFAULT_ADMIN_EMAIL=admin@cnf.ci
DEFAULT_ADMIN_PASSWORD=changez_moi_mot_de_passe_fort

# Frontend (client/.env)
REACT_APP_API_URL=http://localhost:5000/api
