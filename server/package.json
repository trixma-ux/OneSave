{
  "name": "onesave-server",
  "version": "1.0.0",
  "description": "Backend API pour OneSave",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "setup:db:dev": "cross-env NODE_ENV=development node scripts/setup-db.js",
    "setup:db:prod": "cross-env NODE_ENV=production node scripts/setup-db.js",
    "test": "jest --passWithNoTests",
    "test:e2e": "jest --config jest-e2e.config.js --runInBand",
    "test:db:push": "prisma db push --skip-generate"
  },
  "dependencies": {
    "@prisma/client": "^5.7.1",
    "@types/supertest": "^6.0.3",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "cross-env": "^10.1.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "iconv-lite": "^0.7.0",
    "jest": "^30.2.0",
    "jsonwebtoken": "^9.0.2",
    "supertest": "^7.1.4",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.5",
    "nodemon": "^3.1.11",
    "prisma": "^5.22.0",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
